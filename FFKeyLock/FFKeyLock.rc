#include "Resource.h"
#include "Version.h"
#include <winres.h>

IDI_FFKEYLOCK ICON "FFKeyLock.ico"
IDI_SMALL ICON "FFKeyLock.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION FFKEYLOCK_VERSION_MAJOR,FFKEYLOCK_VERSION_MINOR,FFKEYLOCK_VERSION_PATCH,0
 PRODUCTVERSION FFKEYLOCK_VERSION_MAJOR,FFKEYLOCK_VERSION_MINOR,FFKEYLOCK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "brealin\0"
            VALUE "FileDescription", "FFKeyLock\0"
            VALUE "FileVersion", FFKEYLOCK_VERSION_TEXT_RC
            VALUE "InternalName", "FFKeyLock\0"
            VALUE "OriginalFilename", "FFKeyLock.exe\0"
            VALUE "ProductName", "FFKeyLock\0"
            VALUE "ProductVersion", FFKEYLOCK_VERSION_TEXT_RC
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
